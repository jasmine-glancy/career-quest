# Copy this file to .env (same directory) and fill in real local values.
# .env is gitignored — never commit it.

POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=career_quest

# Must match the Postgres credentials above.
DATABASE_URL=postgresql+psycopg2://changeme:changeme@localhost:5432/career_quest

# Used by the /ai/* endpoints (Job Fit Analyzer). Leave blank in dev if you don't
# need those endpoints — they'll return a 502 instead of failing at startup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
